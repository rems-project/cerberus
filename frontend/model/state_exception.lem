open import Pervasives
import Exception

(* HACK: most of the inlines are only added to prevent Lem's renaming *)

type stExceptM 'a 'st 'msg =
  'st -> Exception.exceptM ('a * 'st) 'msg

val stExcept_return: forall 'a 's 'msg. 'a -> stExceptM 'a 's 'msg
let stExcept_return a = fun s -> Exception.return (a, s)

val stExcept_bind:
  forall 'a 'b 's 'msg.
  stExceptM 'a 's 'msg -> ('a -> stExceptM 'b 's 'msg) -> stExceptM 'b 's 'msg
let stExcept_bind m f = fun s -> Exception.bind (m s) (fun (a, s') -> (f a) s')


val fmap: forall 'a 'b 's 'msg. ('a -> 'b) -> stExceptM 'a 's 'msg -> stExceptM 'b 's 'msg
let inline fmap f m = stExcept_bind m (fun z -> stExcept_return $ f z)

val app:
  forall 'a 'b 's 'msg.
  stExceptM ('a -> 'b) 's 'msg -> stExceptM 'a 's 'msg -> stExceptM 'b 's 'msg
let inline app mf m = stExcept_bind mf (fun f -> fmap f m)


val stExcept_mapM_aux:
  forall 'a 'b 's 'msg.
  ('a -> stExceptM 'b 's 'msg) -> list 'b -> list 'a -> stExceptM (list 'b) 's 'msg
let rec stExcept_mapM_aux f acc = function
  | [] ->
      stExcept_return (List.reverse acc)
  | x :: xs ->
      stExcept_bind (f x) (fun y -> stExcept_mapM_aux f (y :: acc) xs)
end
let stExcept_mapM f xs = stExcept_mapM_aux f [] xs


val stExcept_mapM_:
  forall 'a 'b 's 'msg. ('a -> stExceptM 'b 's 'msg) -> list 'a -> stExceptM unit 's 'msg
let rec stExcept_mapM_ f = function
  | [] ->
      stExcept_return ()
  | x :: xs ->
      stExcept_bind (f x) (fun _ -> stExcept_mapM_ f xs)
end
let inline mapM_ f _as = stExcept_mapM_ f _as


val stExcept_foldlM:
  forall 'a 'b 's 'msg.
  ('a -> 'b -> stExceptM 'a 's 'msg) -> 'a -> list 'b -> stExceptM 'a 's 'msg
let rec stExcept_foldlM f a = function
  | []    -> stExcept_return a
  | b::bs -> stExcept_bind (f a b) (fun a' -> stExcept_foldlM f a' bs)
end


(* Exception failure *)
let inline fail msg = fun _ -> Exception.fail msg


(* The state actions *)
val read:   forall 'a 's 'msg. ('s -> 'a) -> stExceptM 'a 's 'msg
val update: forall 's 'msg. ('s -> 's) -> stExceptM unit 's 'msg
val modify: forall 'a 's 'msg. ('s -> 'a * 's) -> stExceptM 'a 's 'msg
val eval:   forall 'a 'b 's 'msg. stExceptM 'a 's 'msg -> 's -> Exception.exceptM 'a 'msg
let stExcept_read   f = fun s -> Exception.return (f s, s)
let stExcept_update f = fun s -> Exception.return ((), f s)
let stExcept_modify f = fun s -> Exception.return (f s)
let stExcept_eval   m = fun s -> Exception.fmap fst (m s)
let inline read = stExcept_read
let inline update = stExcept_update
let inline modify = stExcept_modify
let inline eval = stExcept_eval

val get: forall 'st 'msg. stExceptM 'st 'st 'msg
val put: forall 'st 'msg. 'st -> stExceptM unit 'st 'msg
let stExcept_get = fun st -> Exception.return (st, st)
let stExcept_put st = fun _ -> Exception.return ((), st)
let inline get = stExcept_get
let inline put = stExcept_put

val run: forall 'a 's 'msg. stExceptM 'a 's 'msg -> 's -> Exception.exceptM ('a * 's) 'msg
let stExcept_run m = fun st -> m st
let inline run = stExcept_run


val liftException: forall 'a 'state 'msg. Exception.exceptM 'a 'msg -> stExceptM 'a 'state 'msg
let liftException m =
  fun st -> Exception.fmap (fun z -> (z, st)) m 


(* HACK: this is a hack to prevent Lem from generating OCaml code with random renamings *)
let inline foldlM = stExcept_foldlM

let inline return = stExcept_return
let inline bind = stExcept_bind
let inline mapM = stExcept_mapM
