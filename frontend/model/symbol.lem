open import Basic_classes Bool Num Maybe Show Loc

declare {ocaml} rename module = Lem_symbol

type identifier
val mk_identifier : Loc.t -> string -> identifier
val equal_identifier : identifier -> identifier -> bool
val compare_identifier : identifier -> identifier -> ordering
val string_of_identifier : identifier -> string
val loc_of_identifier : identifier -> Loc.t
val freshify_identifier : identifier -> nat -> identifier

declare ocaml target_rep type identifier = `Cerb_symbol.Identifier.t`
declare ocaml target_rep function mk_identifier = `Cerb_symbol.Identifier.mk`
declare ocaml target_rep function equal_identifier = `Cerb_symbol.Identifier.equal`
declare ocaml target_rep function compare_identifier = `Cerb_symbol.Identifier.compare`
declare ocaml target_rep function string_of_identifier = `Cerb_symbol.Identifier.to_string`
declare ocaml target_rep function loc_of_identifier = `Cerb_symbol.Identifier.get_loc`
declare ocaml target_rep function freshify_identifier = `Cerb_symbol.Identifier.freshify`

instance (Eq identifier)
  let (=) = equal_identifier
  let (<>) ident1 ident2 = not (equal_identifier ident1 ident2)
end

instance (SetType identifier)
  let setElemCompare = compare_identifier
end

instance (Show identifier)
  let show = string_of_identifier
end

instance (Located identifier)
  let locOf = loc_of_identifier
end


type symbol_description =
  | SD_None
  | SD_unnamed_tag of Loc.t
  | SD_Id of string
  | SD_CN_Id of string
  | SD_ObjectAddress of string
  | SD_Return
  | SD_FunArgValue of string
  | SD_FunArg of (Loc.t * nat)
declare ocaml target_rep type symbol_description = `Cerb_symbol.Sym.description`
declare ocaml target_rep function SD_None = `Cerb_symbol.Sym.SD_None`
declare ocaml target_rep function SD_unnamed_tag = `Cerb_symbol.Sym.SD_unnamed_tag`
declare ocaml target_rep function SD_Id = `Cerb_symbol.Sym.SD_Id`
declare ocaml target_rep function SD_CN_Id = `Cerb_symbol.Sym.SD_CN_Id`
declare ocaml target_rep function SD_ObjectAddress = `Cerb_symbol.Sym.SD_ObjectAddress`
declare ocaml target_rep function SD_Return = `Cerb_symbol.Sym.SD_Return`
declare ocaml target_rep function SD_FunArgValue = `Cerb_symbol.Sym.SD_FunArgValue`
declare ocaml target_rep function SD_FunArg = `Cerb_symbol.Sym.SD_FunArg`

type sym
val equal_sym : sym -> sym -> bool
val compare_sym : sym -> sym -> ordering
val show_sym : sym -> string
val match_id : sym -> maybe string
val symbol_description : sym -> symbol_description
val set_symbol_description : sym -> symbol_description -> sym
val from_same_translation_unit : sym -> sym -> bool
declare ocaml target_rep type sym = `Cerb_symbol.Sym.t`
declare ocaml target_rep function equal_sym = `Cerb_symbol.Sym.equal`
declare ocaml target_rep function compare_sym = `Cerb_symbol.Sym.compare`
declare ocaml target_rep function show_sym = `Cerb_symbol.Sym.show`
declare ocaml target_rep function match_id = `Cerb_symbol.Sym.match_id`
declare ocaml target_rep function symbol_description = `Cerb_symbol.Sym.get_desc`
declare ocaml target_rep function set_symbol_description = `Cerb_symbol.Sym.set_desc`
declare ocaml target_rep function from_same_translation_unit = `Cerb_symbol.Sym.from_same_translation_unit`

instance (Eq sym)
  let (=) = equal_sym
  let (<>) sym1 sym2 = not (equal_sym sym1 sym2)
end

instance (SetType sym)
  let setElemCompare = compare_sym
end

instance (Show sym)
  let show = show_sym
end

val fresh: unit -> sym
val fresh_pretty : string -> sym
val fresh_cn : string -> sym
val fresh_pretty_with_id : (nat -> string) -> sym
(* val fresh_fancy : maybe string -> sym *)
val fresh_funarg : Loc.t -> nat -> sym
val fresh_with_description : symbol_description -> sym
val fresh_object_address : string -> sym
val fresh_unnamed_tag : Loc.t -> sym
declare ocaml target_rep function fresh = `Cerb_symbol.Sym.fresh`
declare ocaml target_rep function fresh_pretty = `Cerb_symbol.Sym.fresh_pretty`
declare ocaml target_rep function fresh_cn = `Cerb_symbol.Sym.fresh_cn`
declare ocaml target_rep function fresh_pretty_with_id = `Cerb_symbol.Sym.fresh_pretty_with_id`
(* declare ocaml target_rep function fresh_fancy = `Cerb_symbol.Sym.fresh_fancy` *)
declare ocaml target_rep function fresh_funarg = `Cerb_symbol.Sym.fresh_funarg`
declare ocaml target_rep function fresh_with_description = `Cerb_symbol.Sym.fresh_with_description`
declare ocaml target_rep function fresh_unnamed_tag = `Cerb_symbol.Sym.fresh_unnamed_tag`
declare ocaml target_rep function fresh_object_address = `Cerb_symbol.Sym.fresh_object_address`

type prefix
(* The constructors prefixed with [mk_] query the [Cerb_fresh.digest] state *)
val mk_funarg_prefix : Loc.t -> int -> prefix
val compound_literal_prefix : Loc.t -> sym -> prefix
val source_prefix : Loc.t -> list sym -> prefix
val temporary_lifetime_prefix : Loc.t -> sym -> prefix
val string_literal_prefix : Loc.t -> sym -> prefix
val other_prefix : string -> prefix
declare ocaml target_rep type prefix = `Cerb_symbol.prefix`
declare ocaml target_rep function mk_funarg_prefix = `Cerb_symbol.mk_funarg_prefix`
declare ocaml target_rep function compound_literal_prefix = `Cerb_symbol.compound_literal_prefix`
declare ocaml target_rep function source_prefix = `Cerb_symbol.source_prefix`
declare ocaml target_rep function temporary_lifetime_prefix = `Cerb_symbol.temporary_lifetime_prefix`
declare ocaml target_rep function string_literal_prefix = `Cerb_symbol.string_literal_prefix`
declare ocaml target_rep function other_prefix = `Cerb_symbol.other_prefix`

val fresh_int : unit -> nat
declare ocaml target_rep function fresh_int = `Cerb_fresh.int`
