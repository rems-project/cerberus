open import Pervasives
import Loc

declare {ocaml} rename module = Lem_debug

(* Sources use the enclosing OCaml function name on first use.
   Proof backends erase logging operations without evaluating messages. *)

(* Callbacks can emit zero or several messages. Keep diagnostic conditions
   and message construction inside the callback, and do not retain emitters. *)
val debug : ((string -> unit) -> unit) -> unit
let ~{ocaml} debug msg = ()
declare ocaml target_rep function debug msg = `Cerb_log.debug_string` `__FUNCTION__` msg

val warn : ((string -> unit) -> unit) -> unit
let ~{ocaml} warn msg = ()
declare ocaml target_rep function warn msg = `Cerb_log.warn_string` `__FUNCTION__` msg

val err : ((string -> unit) -> unit) -> unit
let ~{ocaml} err msg = ()
declare ocaml target_rep function err msg = `Cerb_log.err_string` `__FUNCTION__` msg

val debug_located : Loc.t -> ((string -> unit) -> unit) -> unit
let ~{ocaml} debug_located loc msg = ()
declare ocaml target_rep function debug_located loc msg = `Cerb_log.debug_located_string` `__FUNCTION__` loc msg
