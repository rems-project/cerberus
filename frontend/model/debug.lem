open import Pervasives
import Loc

declare {ocaml} rename module = Lem_debug

(* Info/warning/error sources are explicit and created at module scope.
   Debug sources use the enclosing OCaml function name on first use.
   Proof backends erase both sources and logging operations. *)
type src = | No_source
declare ocaml target_rep type src = `Logs.src`

val source : string -> src
let ~{ocaml} source name = No_source
declare ocaml target_rep function source name = `Logs.Src.create` name

(* Only needed when the decision to log itself is expensive. *)
val debug_enabled : unit -> bool
let ~{ocaml} debug_enabled u = false
declare ocaml target_rep function debug_enabled u = `Cerb_log_auto.debug_enabled` `__FUNCTION__`

val debug : (unit -> string) -> unit
let ~{ocaml} debug msg = ()
declare ocaml target_rep function debug msg = `Cerb_log_auto.debug` `__FUNCTION__` msg

val info : src -> (unit -> string) -> unit
let ~{ocaml} info src msg = ()
declare ocaml target_rep function info = `Cerb_log.info`

val warn : src -> (unit -> string) -> unit
let ~{ocaml} warn src msg = ()
declare ocaml target_rep function warn = `Cerb_log.warn`

val err : src -> (unit -> string) -> unit
let ~{ocaml} err src msg = ()
declare ocaml target_rep function err = `Cerb_log.err`

val debug_located : Loc.t -> (unit -> string) -> unit
let ~{ocaml} debug_located loc msg = ()
declare ocaml target_rep function debug_located loc msg = `Cerb_log_auto.debug_located` `__FUNCTION__` loc msg
