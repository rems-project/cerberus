(* An interface for SibylFS *)
open import Num Maybe Either

type fs_stat
declare ocaml target_rep type fs_stat = `Cerb_sibylfs.fs_stat`

val fs_dev: fs_stat -> integer
declare ocaml target_rep function fs_dev = `Cerb_sibylfs.fs_dev`

val fs_ino: fs_stat -> integer
declare ocaml target_rep function fs_ino = `Cerb_sibylfs.fs_ino`

val fs_mode: fs_stat -> integer
declare ocaml target_rep function fs_mode = `Cerb_sibylfs.fs_mode`

val fs_nlink: fs_stat -> integer
declare ocaml target_rep function fs_nlink = `Cerb_sibylfs.fs_nlink`

val fs_uid: fs_stat -> integer
declare ocaml target_rep function fs_uid = `Cerb_sibylfs.fs_uid`

val fs_gid: fs_stat -> integer
declare ocaml target_rep function fs_gid = `Cerb_sibylfs.fs_gid`

val fs_rdev: fs_stat -> integer
declare ocaml target_rep function fs_rdev = `Cerb_sibylfs.fs_rdev`

val fs_size: fs_stat -> integer
declare ocaml target_rep function fs_size = `Cerb_sibylfs.fs_size`

val fs_atime: fs_stat -> integer
declare ocaml target_rep function fs_atime = `Cerb_sibylfs.fs_atime`

val fs_mtime: fs_stat -> integer
declare ocaml target_rep function fs_mtime = `Cerb_sibylfs.fs_mtime`

val fs_ctime: fs_stat -> integer
declare ocaml target_rep function fs_ctime = `Cerb_sibylfs.fs_ctime`

type fs_error
declare ocaml target_rep type fs_error = `Cerb_sibylfs.Fs_error.t`

val fs_string_of_error: fs_error -> string
declare ocaml target_rep function fs_string_of_error = `Sexplib.Sexp.to_string @@ Cerb_sibylfs.Fs_error.to_sexp`

type fs_state
declare ocaml target_rep type fs_state = `Cerb_sibylfs.Fs_state.t`

val fs_initial_state: fs_state
declare ocaml target_rep function fs_initial_state = `Cerb_sibylfs.Fs_state.initial_state`

val string_of_fs_state: fs_state -> string
declare ocaml target_rep function string_of_fs_state = `Sexplib.Sexp.to_string_hum @@ Cerb_sibylfs.Fs_state.to_sexp`

val fs_mkdir: fs_state -> string -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_mkdir = `Cerb_sibylfs.run_mkdir`

val fs_open: fs_state -> string -> integer -> maybe integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_open = `Cerb_sibylfs.run_open`

val fs_close: fs_state -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_close = `Cerb_sibylfs.run_close`

val fs_write: fs_state -> integer -> list char -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_write = `Cerb_sibylfs.run_write`

val fs_read: fs_state -> integer -> integer -> fs_state * (either fs_error (list char))
declare ocaml target_rep function fs_read = `Cerb_sibylfs.run_read`

val fs_pwrite: fs_state -> integer -> list char -> integer -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_pwrite = `Cerb_sibylfs.run_pwrite`

val fs_pread: fs_state -> integer -> integer -> integer -> fs_state * (either fs_error (list char))
declare ocaml target_rep function fs_pread = `Cerb_sibylfs.run_pread`

val fs_rename: fs_state -> string -> string -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_rename = `Cerb_sibylfs.run_rename`

val fs_umask: fs_state -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_umask = `Cerb_sibylfs.run_umask`

val fs_chmod: fs_state -> string -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_chmod = `Cerb_sibylfs.run_chmod`

val fs_chdir: fs_state -> string -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_chdir = `Cerb_sibylfs.run_chdir`

val fs_chown: fs_state -> string -> integer -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_chown = `Cerb_sibylfs.run_chown`

val fs_link: fs_state -> string -> string -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_link = `Cerb_sibylfs.run_link`

val fs_readlink: fs_state -> string -> fs_state * (either fs_error (list char))
declare ocaml target_rep function fs_readlink = `Cerb_sibylfs.run_readlink`

val fs_symlink: fs_state -> string -> string -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_symlink = `Cerb_sibylfs.run_symlink`

val fs_rmdir: fs_state -> string -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_rmdir = `Cerb_sibylfs.run_rmdir`

val fs_truncate: fs_state -> string -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_truncate = `Cerb_sibylfs.run_truncate`

val fs_unlink: fs_state -> string -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_unlink = `Cerb_sibylfs.run_unlink`

val fs_lseek: fs_state -> integer -> integer -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_lseek = `Cerb_sibylfs.run_lseek`

val fs_stat: fs_state -> string -> fs_state * (either fs_error fs_stat)
declare ocaml target_rep function fs_stat = `Cerb_sibylfs.run_stat`

val fs_lstat: fs_state -> string -> fs_state * (either fs_error fs_stat)
declare ocaml target_rep function fs_lstat = `Cerb_sibylfs.run_lstat`

val fs_opendir: fs_state -> string -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_opendir = `Cerb_sibylfs.run_opendir`

val fs_readdir: fs_state -> integer -> fs_state * (either fs_error (list char))
declare ocaml target_rep function fs_readdir = `Cerb_sibylfs.run_readdir`

val fs_rewinddir: fs_state -> integer -> fs_state
declare ocaml target_rep function fs_rewinddir = `Cerb_sibylfs.run_rewinddir`

val fs_closedir: fs_state -> integer -> fs_state * (either fs_error nat)
declare ocaml target_rep function fs_closedir = `Cerb_sibylfs.run_closedir`
