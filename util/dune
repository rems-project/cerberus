(library
 (name cerb_util)
 (public_name cerberus-lib.util)
 (synopsis "Cerberus util library")
 (modules :standard)
 (private_modules cerb_log_compat)
 (wrapped false)
 (foreign_stubs (language c) (names cerberus_cstubs cerb_log_native_stubs))
 (libraries unix str lem pprint yojson logs logs.cli threads cmdliner saturn))

(rule
 (enabled_if (< %{ocaml_version} 5.1))
 (action (copy cerb_log_compat.ocaml4.ml cerb_log_compat.ml)))

(rule
 (enabled_if (>= %{ocaml_version} 5.1))
 (action (copy cerb_log_compat.ocaml5.ml cerb_log_compat.ml)))

(rule
 (target n1570.ml)
 (deps ../tools/n1570.json)
 (action
  (with-stdout-to n1570.ml (progn
   (echo "let data : Yojson.Basic.t Lazy.t =\n")
   (echo "  lazy (Yojson.Basic.from_string  {json|\n")
   (cat ../tools/n1570.json)
   (echo "\n|json})")))))
